<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 播放保活（2026-09-26）：前台媒体服务 + 播放期 CPU/WiFi 锁，修复播放中被杀后台 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 33+ 通知运行时权限：不授予时服务照常运行，仅媒体通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 封面保存到下载文件夹：API 29+ 走 MediaStore.Downloads 免权限；
         API 26~28 需直写公共目录，故仅对旧版本声明 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".WmusicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NCM">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 播放保活：播放意图存在时由 PlayerEngine 拉起 startForeground，暂停即撤 -->
        <service
            android:name=".data.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ★ 系统媒体界面接入点（2026-10-01 对齐 OPPO 手表音乐包 com.allsaints.wearmusic）
             系统（ColorOS Watch 表盘音乐卡片 / 下拉媒体控制 / 「正在播放」页）扫描这个
             action 发现媒体会话服务并绑定，随后读 MediaSession 的元数据与播放状态渲染界面。
             缺任何一项都扫不到：exported=true（允许系统进程绑定）+ mediaPlayback 前台类型 +
             androidx.media3.session.MediaSessionService 这个 action。
             注意：通知与前台保活仍归上面的 PlaybackService，本服务只做「被系统看见」，
             不发自己的通知（见 MusicSessionService.onUpdateNotification 的覆盖说明）。 -->
        <service
            android:name=".data.MusicSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
